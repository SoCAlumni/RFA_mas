{
  "openapi": "3.1.0",
  "info": {
    "title": "RFA knowledge contract (실무대장 ↔ 언론사) — rfa_mas provider",
    "summary": "RFA_module knowledge stub replacement backed by the RFA core",
    "description": "Implements SoCAlumni/RFA_module@819053f contracts/knowledge.openapi.yaml. Audience: public. Answers use only evidence the audience may read and share; empty answer = no knowledge. No review, approval or publication happens here.",
    "version": "0.1.0"
  },
  "paths": {
    "/tasks": {
      "get": {
        "summary": "지금 살아 있는 task 목록 (동적)",
        "operationId": "listTasks",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskInfo"
                  },
                  "title": "Response Listtasks"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeUnauthorized"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{task_id}/ask": {
      "post": {
        "summary": "task supervisor 에게 질문",
        "operationId": "askTask",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          },
          {
            "name": "X-RFA-Actor",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Rfa-Actor"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeResult"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeNotFound"
                }
              }
            },
            "description": "Not Found"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeUnauthorized"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "description": "`POST /tasks/{task_id}/ask` body. Extra hint fields from newer callers are ignored."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KnowledgeNotFound": {
        "properties": {
          "error": {
            "type": "string",
            "const": "not_found",
            "title": "Error",
            "default": "not_found"
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "title": "KnowledgeNotFound"
      },
      "KnowledgeResult": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources",
            "description": "answer 의 근거를 한 줄씩. 없으면 []"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "answer",
          "confidence"
        ],
        "title": "KnowledgeResult",
        "description": "Answer plus one evidence line per source. Empty `answer` means \"no knowledge\"."
      },
      "KnowledgeUnauthorized": {
        "properties": {
          "error": {
            "type": "string",
            "const": "authentication_required",
            "title": "Error",
            "default": "authentication_required"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "KnowledgeUnauthorized"
      },
      "TaskInfo": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Id",
            "examples": [
              "triv3"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "updated_at": {
            "type": "string",
            "format": "date",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "updated_at"
        ],
        "title": "TaskInfo",
        "description": "One live task the writer may ask about (`GET /tasks`)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
