{
  "openapi": "3.1.0",
  "info": {
    "title": "RFA knowledge server — /ask",
    "summary": "desk(대응 에이전트) ↔ 지식 서버 계약",
    "description": "head → broker → task agent → censor 를 수행하는 `ask()` 하나를 노출한다. `audience` 가 검열 프로파일을 정한다(public→public, company/self→internal). 동기 응답(서버 타임아웃 180초 → refusal no_knowledge/timeout). 같은 request_id 는 캐시 응답. `feedback[].reason` 은 사람 입력으로 신뢰되어 검열 규칙(learned.yaml)으로 되먹임된다. 인증: `Authorization: Bearer <RFA_ASK_TOKEN>` (.env.dev).",
    "version": "1.0.0"
  },
  "paths": {
    "/ask": {
      "post": {
        "tags": [
          "ask"
        ],
        "summary": "Post Ask",
        "operationId": "ask",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chat/sync": {
      "post": {
        "tags": [
          "personal"
        ],
        "summary": "Post Chat Sync",
        "description": "개인 채팅 JSON 동기 버전(CLI 용, audience self). 프런트는 SSE `POST /chat` 을 쓴다.",
        "operationId": "chatSync",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/teams": {
      "post": {
        "tags": [
          "teams"
        ],
        "summary": "Post Team",
        "description": "요구사항(자연어 name/description) → 승인된 역할 카탈로그(roles.yaml) 안에서 패터닝 → 기본 샌드박스에 supervisor(secondary) + 멤버를 선언(teams.yaml)·적용(agents apply)·시드하고 /ask 카탈로그에 등록한다.",
        "operationId": "createTeam",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeamCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          },
          "200": {
            "description": "같은 task_id 의 기존 팀 (멱등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          }
        }
      },
      "get": {
        "tags": [
          "teams"
        ],
        "summary": "List Teams",
        "operationId": "listTeams",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/teams/{team_id}": {
      "get": {
        "tags": [
          "teams"
        ],
        "summary": "Get Team",
        "operationId": "getTeam",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Team Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "teams"
        ],
        "summary": "Delete Team",
        "operationId": "removeTeam",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Team Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/agents": {
      "get": {
        "tags": [
          "frontend"
        ],
        "summary": "List Agents",
        "description": "대화 가능한 에이전트(assistant + task 에이전트 + 팀 supervisor). censor 는 제외.",
        "operationId": "listAgents",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AgentRef"
                  },
                  "type": "array",
                  "title": "Response Listagents"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "frontend"
        ],
        "summary": "Me",
        "description": "Bearer RFA_ASK_TOKEN 이 맞으면 owner/admin, 아니면 guest (401 없이 항상 200).",
        "operationId": "me",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": [
          "frontend"
        ],
        "summary": "List Tasks",
        "description": "head 가 라우팅할 수 있는 task 목록: ask.yaml 카탈로그 + 스폰된 팀. gradeLabel 은 배치 샌드박스의 보안 등급.",
        "operationId": "listTasks",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TaskView"
                  },
                  "type": "array",
                  "title": "Response Listtasks"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "frontend"
        ],
        "summary": "Chat Stream",
        "description": "개인 채팅 SSE. 이벤트 봉투 `{type, runId, seq, ts, data}`; type: `run.started` {role, audience, profile, conversationId, requestId}, `stage` {stage: head|task:<id>|censor, ms, outcome, …}, `guard.final` guest only — {verdict: allow|redact|block, redactions: [reason], blocked: bool, reason?}, `delta` {text} — one sentence of the censored answer, `done` {requestId, task: {id,name}|null, refusal: {code,message}|null, censor: {profile,verdict,redactions}, ms}, `error` {code, message}",
        "operationId": "chatStream",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatStreamRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream of SseEnvelope frames",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "schema": {
                  "description": "Every SSE event of every stream: ``{type, runId, seq, ts, data}``. ``type`` names may change\nwith the front-end; the envelope does not.",
                  "properties": {
                    "type": {
                      "description": "event name, e.g. run.started | stage | delta | guard.final | done | error",
                      "title": "Type",
                      "type": "string"
                    },
                    "runId": {
                      "title": "Runid",
                      "type": "string"
                    },
                    "seq": {
                      "description": "0-based, strictly increasing within a run",
                      "minimum": 0,
                      "title": "Seq",
                      "type": "integer"
                    },
                    "ts": {
                      "description": "unix seconds",
                      "title": "Ts",
                      "type": "number"
                    },
                    "data": {
                      "additionalProperties": true,
                      "title": "Data",
                      "type": "object"
                    }
                  },
                  "required": [
                    "type",
                    "runId",
                    "seq",
                    "ts"
                  ],
                  "title": "SseEnvelope",
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentRef": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "color": {
            "type": "string",
            "title": "Color",
            "description": "#rrggbb, stable per agent id"
          },
          "sandbox": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sandbox"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "kind": {
            "type": "string",
            "enum": [
              "assistant",
              "task",
              "supervisor"
            ],
            "title": "Kind",
            "default": "task"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "color",
          "sandbox"
        ],
        "title": "AgentRef"
      },
      "AskRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
            "title": "Request Id",
            "description": "멱등키. 같은 id 재요청 시 캐시 응답"
          },
          "question": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Question"
          },
          "channel": {
            "type": "string",
            "enum": [
              "github",
              "slack",
              "cli",
              "web"
            ],
            "title": "Channel",
            "description": "github|slack (desk). cli|web 은 개인 채팅"
          },
          "audience": {
            "type": "string",
            "enum": [
              "public",
              "company",
              "self"
            ],
            "title": "Audience",
            "description": "public→censor profile public, company/self→internal"
          },
          "target": {
            "type": "string",
            "maxLength": 500,
            "title": "Target",
            "description": "스레드·이슈 식별자(계보 추적)",
            "default": ""
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "requester": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Requester"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/ContextItem"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Context"
          },
          "feedback": {
            "items": {
              "$ref": "#/components/schemas/FeedbackItem"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Feedback"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "question",
          "channel",
          "audience"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "knowledge": {
            "type": "string",
            "title": "Knowledge",
            "description": "검열을 통과한 텍스트. refusal 이 있으면 빈 문자열"
          },
          "task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "refusal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Refusal"
              },
              {
                "type": "null"
              }
            ]
          },
          "censor": {
            "$ref": "#/components/schemas/CensorSummary"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "knowledge",
          "task",
          "refusal",
          "censor"
        ],
        "title": "AskResponse"
      },
      "CensorSummary": {
        "properties": {
          "profile": {
            "type": "string",
            "title": "Profile"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "allow",
              "redact"
            ],
            "title": "Verdict"
          },
          "redactions": {
            "items": {
              "$ref": "#/components/schemas/Redaction"
            },
            "type": "array",
            "title": "Redactions"
          }
        },
        "type": "object",
        "required": [
          "profile",
          "verdict"
        ],
        "title": "CensorSummary"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Question"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "channel": {
            "type": "string",
            "enum": [
              "cli",
              "web"
            ],
            "title": "Channel",
            "default": "web"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest",
        "description": "Personal chat (audience self) — same ``ask()`` function, request_id issued by the server."
      },
      "ChatStreamRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "guest"
            ],
            "title": "Role",
            "default": "guest"
          },
          "conversationId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversationid"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryItem"
            },
            "type": "array",
            "maxItems": 50,
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ChatStreamRequest",
        "description": "``POST /chat`` (SSE). ``role`` is what the front-end claims; only an authenticated caller\n(bearer RFA_ASK_TOKEN) is granted ``owner`` — anyone else is treated as ``guest``."
      },
      "ContextItem": {
        "properties": {
          "author": {
            "type": "string",
            "maxLength": 200,
            "title": "Author",
            "default": ""
          },
          "text": {
            "type": "string",
            "maxLength": 8000,
            "title": "Text"
          },
          "at": {
            "type": "string",
            "maxLength": 64,
            "title": "At",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ContextItem",
        "description": "One message of the external thread (untrusted input: shown to the head as data only)."
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "ErrorBody"
      },
      "FeedbackItem": {
        "properties": {
          "draft": {
            "type": "string",
            "maxLength": 20000,
            "title": "Draft",
            "default": ""
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "at": {
            "type": "string",
            "maxLength": 64,
            "title": "At",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "FeedbackItem",
        "description": "One rejected draft. ``reason`` is human input (trusted, fed back into the censor rules);\n``draft`` is external text (data only)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryItem": {
        "properties": {
          "role": {
