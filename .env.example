# Copy-safe template. Run `uv run rfa init-env --output .env.dev` to create a
# mode-0600 development profile with distinct credentials. NVIDIA_API_KEY stays user-supplied.
# Generated credentials are not automatically registered/verified with any service.
# All service endpoints below are local except NVIDIA. HTTP means reference transport,
# not proven service readiness. Doctor does no live probe or environment mutation.
# Local application. Setting APP_API_KEY enables bearer auth even on loopback;
# an external bind requires it.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_API_KEY=
DATABASE_URL=sqlite:///./.local/rfa.db
# Optional CHECKPOINT_PATH; when omitted uses <database filename>.checkpoints.sqlite.
# Keep test/install checkpoint files separate; never point this at another user's DB.
CHECKPOINT_PATH=

# mock requires no key. nvidia is reserved in P0 and additionally requires a verified model ID.
MODEL_PROVIDER=mock
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=

# local | mock | nemo_cli | nemo_service. local is the real SQLite lexical reader;
# mock is the explicit simulation fixture. The two NeMo backends are reserved for P1.
# 7670 is the owned/swappable NeMo Retriever service boundary.
RETRIEVER_BACKEND=local
RETRIEVER_INDEX_DIR=./.local/retriever
RETRIEVER_SERVICE_URL=http://127.0.0.1:7670
NEMO_RETRIEVER_API_TOKEN=

# Owned/swappable response/review service. The bundled contract fixture stays on 8001.
RESPONSE_BACKEND=mock
RESPONSE_BASE_URL=http://127.0.0.1:8011
RESPONSE_API_TOKEN=

# Owned/swappable MCP/tool gateway. P0 HTTP is loopback-only and all writes are denied.
TOOL_BACKEND=mock
TOOL_BASE_URL=http://127.0.0.1:8012
TOOL_API_TOKEN=

# Owned/swappable runtime. local is not an OpenShell sandbox; 8001 remains the test fixture.
RUNTIME_BACKEND=local
RUNTIME_BASE_URL=http://127.0.0.1:8013
RUNTIME_API_TOKEN=

# Owned/swappable policy service. Local policy rules remain the P0 default.
POLICY_BACKEND=local
POLICY_BASE_URL=http://127.0.0.1:8014
POLICY_API_TOKEN=

# Local metadata-only tracing by default. Langfuse self-host defaults to port 3000,
# but the langfuse backend is reserved and fails if selected in P0.
TRACE_BACKEND=local
TRACE_DIR=./.local/traces
TRACE_RETENTION_DAYS=7
LOG_LEVEL=INFO
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional evaluation. No model calls are made by default; non-mock judges are reserved.
ENABLE_JUDGE=false
JUDGE_PROVIDER=mock
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Feature gates do not grant security permission. External writes stay disabled in P0.
ALLOW_EXTERNAL_WRITES=false
# These gates are read but selecting them fails explicitly until implemented.
# They never grant source sharing/egress permission, regardless of installed extras/keys.
ALLOW_EXTERNAL_EGRESS=false
ENABLE_NAT=false
ENABLE_DEBATE=false
ENABLE_AUTO_DOMAIN_CREATION=false

# Single-owner scheduler. Only `rfa scheduler` runs jobs (one process, owner lock);
# the API never starts it. Empty values use: apscheduler, <DATABASE_URL file>.scheduler.sqlite,
# Asia/Seoul, job_type_default (briefing catch-up once; candidate_scan 24h; kb_refresh 1h).
SCHEDULER_ENABLED=false
SCHEDULER_BACKEND=
SCHEDULER_JOBSTORE_URL=
DEFAULT_TIMEZONE=
SCHEDULER_MISFIRE_POLICY=

# Execution budgets.
MAX_GRAPH_STEPS=12
MAX_TOOL_CALLS=6
TOOL_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=30
MAX_READ_RETRIES=1

# Future budget/retention/endpoint settings are NOT active assignments here.
# Canonical planned catalog: settings.py PLANNED_SETTINGS; shown by `rfa doctor`.
# TRACE_DIR is the existing local trace/output boundary; no second trace backend is added.
